        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </div>
    <div class="filter">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Mountains</p>
    </div>

     <div class="filter">
       <i class="fa-regular fa-person-swimming"></i>
        <p>Pools</p>
    </div>

     <div class="filter">
       <i class="fa-solid fa-igloo"></i>
